generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Professional {
  id                  Int                      @id @default(autoincrement())
  name                String
  email               String                   @unique
  passwordHash        String                   @map("password_hash")
  phone               String?
  specialization      String?
  companyId           Int?                     @map("company_id")
  companyName         String?                  @map("company_name")
  logoUrl             String?                  @map("logo_url")
  contractType        String?                  @map("contract_type")
  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @updatedAt @map("updated_at")
  bio                 String?                  @db.Text
  crm                 String?
  photoUrl            String?                  @map("photo_url")
  onboardingCompleted Boolean                  @default(false) @map("onboarding_completed")
  onboardingData      Json?                    @map("onboarding_data")
  googleId            String?                  @unique @map("google_id")
  authProvider        String?                  @default("local") @map("auth_provider")
  appointments        Appointment[]
  auditLogs           AuditLog[]
  catalogItems        CatalogItem[]
  categories          Category[]
  chatHistories       ChatHistory[]
  clients             Client[]
  contracts           Contract[]
  conversas           Conversa[]
  ownedCompanies      Empresa[]                @relation("CompanyOwner")
  fichaTemplates      FichaTemplate[]
  fichas              Ficha[]
  goals               Goal[]
  leads               Lead[]
  payments            Payment[]
  permissions         ProfessionalPermission[]
  company             Empresa?                 @relation("CompanyProfessionals", fields: [companyId], references: [id])
  roles               Role[]
  settingsProfile     SettingsProfile?
  assignedTasks       Task[]                   @relation("AssignedTasks")
  createdTasks        Task[]                   @relation("CreatedTasks")
  notifications       Notification[]
  messageCampaigns    MessageCampaign[]
  billingAddons       BillingAddon[]

  @@map("professionals")
}

model Client {
  id             Int           @id @default(autoincrement())
  professionalId Int           @map("professional_id")
  name           String
  email          String?
  phone          String?
  dateOfBirth    DateTime?     @map("date_of_birth")
  document       String?
  notes          String?
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  tags           String[]      @default([])
  avatar         String?
  city           String?
  socialMedia    String?       @map("social_media")
  companyId      Int?          @map("company_id")
  appointments   Appointment[]
  chatHistories  ChatHistory[]
  company        Empresa?      @relation(fields: [companyId], references: [id])
  professional   Professional  @relation(fields: [professionalId], references: [id])
  conversas      Conversa[]
  fichas         Ficha[]
  originLead     Lead?
  payments       Payment[]
  tasks          Task[]

  @@map("clients")
}

model Lead {
  id                   Int            @id @default(autoincrement())
  professionalId       Int            @map("professional_id")
  name                 String
  value                Decimal        @default(0) @db.Decimal(10, 2)
  origin               String?
  avatar               String?
  status               String
  phone                String
  email                String?
  responsible          String?
  isScheduled          Boolean        @default(false) @map("is_scheduled")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")
  convertedAt          DateTime?      @map("converted_at")
  convertedToClientId  Int?           @unique @map("converted_to_client_id")
  tags                 String[]       @default([])
  discountApplied      Boolean        @default(false) @map("discount_applied")
  justification        String?
  remarketingProposals Json?          @map("remarketing_proposals")
  isPaid               Boolean        @default(false) @map("is_paid")
  notes                String?
  subStatus            String?        @map("sub_status")
  companyId            Int?           @map("company_id")
  appointments         Appointment[]
  activities           LeadActivity[]
  company              Empresa?       @relation(fields: [companyId], references: [id])
  convertedToClient    Client?        @relation(fields: [convertedToClientId], references: [id])
  professional         Professional   @relation(fields: [professionalId], references: [id])
  proposals            Proposal[]
  tasks                Task[]
  conversas            Conversa[]

  @@unique([phone, companyId])
  @@map("leads")
}

model LeadActivity {
  id        Int      @id @default(autoincrement())
  leadId    Int      @map("lead_id")
  type      String
  content   String
  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("lead_activities")
}

model Proposal {
  id              Int      @id @default(autoincrement())
  leadId          Int      @map("lead_id")
  title           String
  value           Decimal  @db.Decimal(10, 2)
  validUntil      DateTime @map("valid_until")
  salespersonId   Int?     @map("salesperson_id")
  specialistId    Int?     @map("specialist_id")
  tags            String[] @default([])
  status          String   @default("pending")
  justification   String?
  discountApplied Boolean  @default(false) @map("discount_applied")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  lead            Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  salesperson     Usuario? @relation("SalespersonProposals", fields: [salespersonId], references: [id])
  specialist      Usuario? @relation("SpecialistProposals", fields: [specialistId], references: [id])

  @@map("proposals")
}

model Category {
  id             Int            @id @default(autoincrement())
  professionalId Int            @map("professional_id")
  name           String
  description    String?
  status         CategoryStatus @default(ativo)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  catalogItems   CatalogItem[]
  professional   Professional   @relation(fields: [professionalId], references: [id])

  @@map("categories")
}

model CatalogItem {
  id              Int               @id @default(autoincrement())
  professionalId  Int               @map("professional_id")
  categoryId      Int?              @map("category_id")
  name            String
  description     String?
  price           Decimal           @db.Decimal(10, 2)
  imageUrl        String?           @map("image_url")
  status          CatalogItemStatus @default(rascunho)
  durationMinutes Int?              @map("duration_minutes")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  appointments    Appointment[]
  category        Category?         @relation(fields: [categoryId], references: [id])
  professional    Professional      @relation(fields: [professionalId], references: [id])

  @@map("catalog_items")
}

model Appointment {
  id              Int               @id @default(autoincrement())
  professionalId  Int               @map("professional_id")
  clientId        Int?              @map("client_id")
  serviceId       Int?              @map("service_id")
  startTime       DateTime          @map("start_time")
  endTime         DateTime          @map("end_time")
  status          AppointmentStatus @default(agendado)
  notes           String?
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  leadId          Int?              @map("lead_id")
  companyId       Int?              @map("company_id")
  appointmentLogs AppointmentLog[]
  client          Client?           @relation(fields: [clientId], references: [id])
  company         Empresa?          @relation(fields: [companyId], references: [id])
  lead            Lead?             @relation(fields: [leadId], references: [id])
  professional    Professional      @relation(fields: [professionalId], references: [id])
  service         CatalogItem?      @relation(fields: [serviceId], references: [id])
  payments        Payment[]

  @@map("appointments")
}

model AppointmentLog {
  id            Int                  @id @default(autoincrement())
  appointmentId Int                  @map("appointment_id")
  action        AppointmentLogAction
  timestamp     DateTime
  userAction    UserActionType       @map("user_action")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")
  appointment   Appointment          @relation(fields: [appointmentId], references: [id])

  @@map("appointment_logs")
}

model Payment {
  id              Int           @id @default(autoincrement())
  appointmentId   Int?          @map("appointment_id")
  clientId        Int           @map("client_id")
  professionalId  Int           @map("professional_id")
  amount          Decimal       @db.Decimal(10, 2)
  method          PaymentMethod
  status          PaymentStatus @default(pendente)
  referencePeriod String?       @map("reference_period")
  date            DateTime
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  companyId       Int?          @map("company_id")
  appointment     Appointment?  @relation(fields: [appointmentId], references: [id])
  client          Client        @relation(fields: [clientId], references: [id])
  company         Empresa?      @relation(fields: [companyId], references: [id])
  professional    Professional  @relation(fields: [professionalId], references: [id])

  @@map("payments")
}

model FichaTemplate {
  id          Int          @id @default(autoincrement())
  name        String
  description String?
  category    String?
  fields      Json
  createdBy   Int          @map("created_by")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  creator     Professional @relation(fields: [createdBy], references: [id])
  fichas      Ficha[]

  @@map("ficha_templates")
}

model Ficha {
  id             Int            @id @default(autoincrement())
  clientId       Int            @map("client_id")
  professionalId Int            @map("professional_id")
  type           FichaType
  templateId     Int?           @map("template_id")
  content        Json
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  client         Client         @relation(fields: [clientId], references: [id])
  professional   Professional   @relation(fields: [professionalId], references: [id])
  template       FichaTemplate? @relation(fields: [templateId], references: [id])

  @@map("fichas")
}

model ChatHistory {
  id             Int          @id @default(autoincrement())
  clientId       Int?         @map("client_id")
  professionalId Int          @map("professional_id")
  sessionId      String?      @map("session_id")
  message        String
  sender         ChatSender
  timestamp      DateTime
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  client         Client?      @relation(fields: [clientId], references: [id])
  professional   Professional @relation(fields: [professionalId], references: [id])

  @@map("chat_histories")
}

model SettingsProfile {
  id             Int          @id @default(autoincrement())
  professionalId Int          @unique @map("professional_id")
  theme          ThemeType    @default(light)
  signatureUrl   String?      @map("signature_url")
  preferences    Json?
  language       String?
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  professional   Professional @relation(fields: [professionalId], references: [id])

  @@map("settings_profile")
}

model AuditLog {
  id          Int          @id @default(autoincrement())
  userId      Int          @map("user_id")
  action      String
  targetTable String       @map("target_table")
  targetId    Int?         @map("target_id")
  timestamp   DateTime
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  user        Professional @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model Contract {
  id             Int              @id @default(autoincrement())
  professionalId Int              @map("professional_id")
  contractType   ContractTypeEnum @map("contract_type")
  documentUrl    String?          @map("document_url")
  startDate      DateTime         @map("start_date")
  endDate        DateTime?        @map("end_date")
  status         ContractStatus   @default(ativo)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  professional   Professional     @relation(fields: [professionalId], references: [id])

  @@map("contracts")
}

model Empresa {
  id                   Int                 @id @default(autoincrement())
  ownerId              Int?                @map("owner_id")
  name                 String
  logoUrl              String?             @map("logo_url")
  domain               String?
  whatsapp             String?
  whatsappProvider     String?             @default("evolution") @map("whatsapp_provider")
  apiKey               String?             @map("api_key")
  evolutionApiUrl      String?             @map("evolution_api_url")
  evolutionInstance    String?             @map("evolution_instance")
  metaToken            String?             @map("meta_token")
  metaPhoneNumberId    String?             @map("meta_phone_number_id")
  webhookToken         String?             @unique @default(uuid()) @map("webhook_token")
  plan                 String?
  openHour             String              @default("08:00") @map("open_hour")
  closeHour            String              @default("20:00") @map("close_hour")
  isActive             Boolean             @default(true) @map("is_active")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")
  
  owner                Professional?       @relation("CompanyOwner", fields: [ownerId], references: [id])
  professionals        Professional[]      @relation("CompanyProfessionals")
  usuarios             Usuario[]
  userCompanyAccess    UserCompanyAccess[]
  agentesIa            AgenteIa[]
  conversas            Conversa[]
  roles                Role[]
  clients              Client[]
  leads                Lead[]
  appointments         Appointment[]
  payments             Payment[]
  funnelConfigs        FunnelConfig[]
  messageCampaigns     MessageCampaign[]
  tasks                Task[]
  notifications        Notification[]
  subscription         CompanySubscription?
  billingAddons        BillingAddon[]

  @@map("empresas")
}

model UserCompanyAccess {
  userId    Int      @map("user_id")
  companyId Int      @map("company_id")
  roleId    Int?     @map("role_id")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  company   Empresa  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role      Role?    @relation(fields: [roleId], references: [id])
  user      Usuario  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, companyId])
  @@map("user_company_access")
}

model Usuario {
  id                     Int                 @id @default(autoincrement())
  companyId              Int?                @map("company_id")
  name                   String
  email                  String              @unique
  passwordHash           String              @map("password_hash")
  roleId                 Int?                @map("role_id")
  isActive               Boolean             @default(true) @map("is_active")
  googleId               String?             @unique @map("google_id")
  authProvider           String?             @default("local") @map("auth_provider")
  onboardingCompleted    Boolean             @default(false) @map("onboarding_completed")
  createdAt              DateTime            @default(now()) @map("created_at")
  updatedAt              DateTime            @updatedAt @map("updated_at")
  
  company                Empresa?            @relation(fields: [companyId], references: [id])
  companyAccess          UserCompanyAccess[]
  role                   Role?               @relation(fields: [roleId], references: [id])
  permissions            UserPermission[]
  proposalsAsSalesperson Proposal[]          @relation("SalespersonProposals")
  proposalsAsSpecialist  Proposal[]          @relation("SpecialistProposals")
  assignedTasks          Task[]              @relation("AssignedUserTasks")
  createdTasks           Task[]              @relation("CreatedUserTasks")
  notifications          Notification[]      @relation("UserNotifications")

  @@map("usuarios")
}

model AgenteIa {
  id          Int        @id @default(autoincrement())
  companyId   Int        @map("company_id")
  name        String
  basePrompt  String     @map("base_prompt")
  temperature Float      @default(0.7)
  mode        String?
  isActive    Boolean    @default(true) @map("is_active")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  company     Empresa    @relation(fields: [companyId], references: [id])
  conversas   Conversa[]

  @@map("agentes_ia")
}

model Conversa {
  id             Int           @id @default(autoincrement())
  companyId      Int           @map("company_id")
  agentId        Int?          @map("agent_id")
  clientId       Int?          @map("client_id")
  leadId         Int?          @map("lead_id")
  professionalId Int?          @map("professional_id")
  phone          String?       // Telefone do contato (para lookup rápido)
  app            String?
  channel        String?
  startedAt      DateTime      @map("started_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  agent          AgenteIa?     @relation(fields: [agentId], references: [id])
  client         Client?       @relation(fields: [clientId], references: [id])
  lead           Lead?         @relation(fields: [leadId], references: [id])
  company        Empresa       @relation(fields: [companyId], references: [id])
  professional   Professional? @relation(fields: [professionalId], references: [id])
  mensagens      Mensagem[]

  @@unique([phone, companyId])
  @@map("conversas")
}

model Mensagem {
  id             Int        @id @default(autoincrement())
  conversationId Int        @map("conversation_id")
  sender         ChatSender
  content        String
  rawJson        Json?      @map("raw_json")
  origin         String?
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  chatLogs       ChatLog[]
  conversation   Conversa   @relation(fields: [conversationId], references: [id])

  @@map("mensagens")
}

model ChatLog {
  id        Int      @id @default(autoincrement())
  messageId Int      @map("message_id")
  rawData   Json     @map("raw_data")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  message   Mensagem @relation(fields: [messageId], references: [id])

  @@map("chat_logs")
}

model Module {
  id                      Int                      @id @default(autoincrement())
  code                    String                   @unique
  name                    String
  description             String?
  icon                    String?
  isActive                Boolean                  @default(true) @map("is_active")
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")
  professionalPermissions ProfessionalPermission[]
  rolePermissions         RolePermission[]
  userPermissions         UserPermission[]
  planModules             PlanModule[]

  @@map("modules")
}

model Plan {
  code          String                @id
  name          String
  description   String?
  priceCents    Int?                  @map("price_cents")
  isActive      Boolean               @default(true) @map("is_active")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")
  modules       PlanModule[]
  subscriptions CompanySubscription[]

  @@map("plans")
}

model PlanModule {
  planCode  String   @map("plan_code")
  moduleId  Int      @map("module_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  module    Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  plan      Plan     @relation(fields: [planCode], references: [code], onDelete: Cascade)

  @@id([planCode, moduleId])
  @@map("plan_modules")
}

model CompanySubscription {
  id                    Int       @id @default(autoincrement())
  companyId             Int       @unique @map("company_id")
  planCode              String    @map("plan_code")
  billingCycle          String    @default("monthly") @map("billing_cycle")
  status                String    @default("trialing")
  trialEndsAt           DateTime  @map("trial_ends_at")
  currentPeriodEndsAt   DateTime? @map("current_period_ends_at")
  abacateSubscriptionId String?   @unique @map("abacate_subscription_id")
  abacateCheckoutId     String?   @map("abacate_checkout_id")
  checkoutUrl           String?   @map("checkout_url")
  canceledAt            DateTime? @map("canceled_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  company               Empresa   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan                  Plan      @relation(fields: [planCode], references: [code])

  @@map("company_subscriptions")
}

model PendingSignup {
  id                Int       @id @default(autoincrement())
  name              String
  email             String    @unique
  passwordHash      String    @map("password_hash")
  phone             String?
  specialization    String?
  companyName       String?   @map("company_name")
  planCode          String    @map("plan_code")
  billingCycle      String    @default("monthly") @map("billing_cycle")
  status            String    @default("pending")
  abacateCheckoutId String?   @unique @map("abacate_checkout_id")
  checkoutUrl       String?   @map("checkout_url")
  companyId         Int?      @map("company_id")
  professionalId    Int?      @map("professional_id")
  completedAt       DateTime? @map("completed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@map("pending_signups")
}

model BillingWebhookEvent {
  id          Int      @id @default(autoincrement())
  provider    String   @default("abacate_pay")
  eventId     String   @unique @map("event_id")
  eventType   String?  @map("event_type")
  payload     Json
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("billing_webhook_events")
}

model BillingAddon {
  id                    Int          @id @default(autoincrement())
  ownerProfessionalId   Int          @map("owner_professional_id")
  targetCompanyId       Int?         @map("target_company_id")
  addonCode             String       @map("addon_code")
  quantity              Int          @default(1)
  billingCycle          String       @default("monthly") @map("billing_cycle")
  status                String       @default("payment_pending")
  abacateSubscriptionId String?      @unique @map("abacate_subscription_id")
  abacateCheckoutId     String?      @unique @map("abacate_checkout_id")
  checkoutUrl           String?      @map("checkout_url")
  currentPeriodEndsAt   DateTime?    @map("current_period_ends_at")
  canceledAt            DateTime?    @map("canceled_at")
  activatedAt           DateTime?    @map("activated_at")
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")
  owner                 Professional @relation(fields: [ownerProfessionalId], references: [id], onDelete: Cascade)
  targetCompany         Empresa?     @relation(fields: [targetCompanyId], references: [id], onDelete: Cascade)

  @@map("billing_addons")
}

model ProfessionalPermission {
  id             Int          @id @default(autoincrement())
  professionalId Int          @map("professional_id")
  moduleId       Int          @map("module_id")
  hasAccess      Boolean      @default(true) @map("has_access")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  module         Module       @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@unique([professionalId, moduleId])
  @@map("professional_permissions")
}

model UserPermission {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  moduleId  Int      @map("module_id")
  hasAccess Boolean  @default(true) @map("has_access")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  module    Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  user      Usuario  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
  @@map("user_permissions")
}

model Goal {
  id             Int          @id @default(autoincrement())
  professionalId Int          @map("professional_id")
  name           String
  revenueTarget  Decimal      @map("revenue_target") @db.Decimal(12, 2)
  avgTicket      Decimal      @map("avg_ticket") @db.Decimal(10, 2)
  schedulingRate Float        @map("scheduling_rate")
  showupRate     Float        @map("showup_rate")
  closingRate    Float        @map("closing_rate")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@map("goals")
}

model Role {
  id                Int                 @id @default(autoincrement())
  companyId         Int                 @map("company_id")
  name              String
  value             String
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  professionalId    Int                 @map("professional_id")
  permissions       RolePermission[]
  company           Empresa             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  professional      Professional        @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  userCompanyAccess UserCompanyAccess[]
  usuarios          Usuario[]

  @@unique([companyId, value])
  @@map("roles")
}

model RolePermission {
  id        Int      @id @default(autoincrement())
  roleId    Int      @map("role_id")
  moduleId  Int      @map("module_id")
  hasAccess Boolean  @default(true) @map("has_access")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  module    Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, moduleId])
  @@map("role_permissions")
}

model FunnelConfig {
  id        Int           @id @default(autoincrement())
  companyId Int           @map("company_id")
  code      String
  label     String
  icon      String        @default("filter_alt")
  order     Int           @default(0)
  isActive  Boolean       @default(true) @map("is_active")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  company   Empresa       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stages    FunnelStage[]

  @@unique([companyId, code])
  @@map("funnel_configs")
}

model FunnelStage {
  id           Int          @id @default(autoincrement())
  funnelId     Int          @map("funnel_id")
  code         String
  label        String
  color        String       @default("bg-blue-500")
  order        Int          @default(0)
  isTransition Boolean      @default(false) @map("is_transition")
  isActive     Boolean      @default(true) @map("is_active")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  funnel       FunnelConfig @relation(fields: [funnelId], references: [id], onDelete: Cascade)

  @@unique([funnelId, code])
  @@map("funnel_stages")
}

