model Task {
  id              Int           @id @default(autoincrement())
  title           String
  description     String?
  status          String        @default("pending") // pending, in_progress, completed
  priority        String        @default("medium") // low, medium, high, urgent
  dueDate         DateTime      @map("due_date")
  assignedToId    Int?          @map("assigned_to_id")
  assignedToUserId Int?         @map("assigned_to_user_id")
  createdById     Int?          @map("created_by_id")
  createdByUserId Int?          @map("created_by_user_id")
  companyId       Int           @map("company_id")
  clientId        Int?          @map("client_id")
  leadId          Int?          @map("lead_id")
  isRecurring     Boolean       @default(false) @map("is_recurring")
  recurrenceRule  String?       @map("recurrence_rule") // daily, weekly, monthly
  parentTaskId    Int?          @map("parent_task_id")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  assignedTo      Professional? @relation("AssignedTasks", fields: [assignedToId], references: [id], onDelete: Cascade)
  assignedToUser  Usuario?      @relation("AssignedUserTasks", fields: [assignedToUserId], references: [id], onDelete: Cascade)
  createdBy       Professional? @relation("CreatedTasks", fields: [createdById], references: [id], onDelete: Cascade)
  createdByUser   Usuario?      @relation("CreatedUserTasks", fields: [createdByUserId], references: [id], onDelete: Cascade)
  company         Empresa       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client          Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  lead            Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  parentTask      Task?         @relation("SubTasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subTasks        Task[]        @relation("SubTasks")
  notifications   Notification[]

  @@map("tasks")
}

model Notification {
  id          Int          @id @default(autoincrement())
  title       String
  content     String
  read        Boolean      @default(false)
  type        String       // task_assigned, task_completed, urgent_alert, etc.
  recipientId Int?         @map("recipient_id")
  recipientUserId Int?     @map("recipient_user_id")
  companyId   Int          @map("company_id")
  taskId      Int?         @map("task_id")
  createdAt   DateTime     @default(now()) @map("created_at")

  recipient   Professional? @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  recipientUser Usuario?    @relation("UserNotifications", fields: [recipientUserId], references: [id], onDelete: Cascade)
  company     Empresa      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  task        Task?        @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// ==================== CAMPANHAS DE MENSAGENS ====================

enum CampaignStatus {
  draft      // Rascunho
  scheduled  // Agendada
  sending    // Em envio
  completed  // Finalizada
  failed     // Falhou
  canceled   // Cancelada
}

enum RecipientStatus {
  pending   // Aguardando envio
  sent      // Enviado com sucesso
  failed    // Falha no envio
  skipped   // Ignorado (sem telefone válido)
}

// Campanhas de mensagens em massa
model MessageCampaign {
  id             Int            @id @default(autoincrement())
  companyId      Int            @map("company_id")
  professionalId Int            @map("professional_id")
  name           String         // Nome da campanha
  message        String         @db.Text // Corpo da mensagem (suporta variáveis como {{nome}})
  audienceType   String         @map("audience_type") // 'all_leads', 'all_clients', 'leads_by_status', 'manual'
  audienceFilter Json?          @map("audience_filter") // Filtros aplicados (status, funil, tags, etc.)
  status         CampaignStatus @default(draft)
  totalRecipients Int           @default(0) @map("total_recipients")
  sentCount      Int            @default(0) @map("sent_count")
  failedCount    Int            @default(0) @map("failed_count")
  mediaUrl       String?        @map("media_url") @db.Text
  mediaType      String?        @map("media_type") // 'image', 'video', 'audio'
  minDelay       Int            @default(180) @map("min_delay")
  maxDelay       Int            @default(200) @map("max_delay")
  randomize      Boolean        @default(false)
  variations     Json?          // Array de strings com as variações de mensagens
  scheduledAt    DateTime?      @map("scheduled_at") // Data de agendamento (se agendada)
  startedAt      DateTime?      @map("started_at")   // Quando começou a enviar
  completedAt    DateTime?      @map("completed_at") // Quando finalizou
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  // Relacionamentos
  company      Empresa              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  professional Professional         @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  recipients   CampaignRecipient[]

  @@map("message_campaigns")
}

// Destinatários individuais de cada campanha
model CampaignRecipient {
  id           Int             @id @default(autoincrement())
  campaignId   Int             @map("campaign_id")
  name         String          // Nome do destinatário
  phone        String          // Telefone do destinatário
  sourceType   String          @map("source_type") // 'lead' ou 'client'
  sourceId     Int             @map("source_id")   // ID do lead ou client
  status       RecipientStatus @default(pending)
  sentAt       DateTime?       @map("sent_at")
  errorMessage String?         @map("error_message")
  renderedMessage String?      @map("rendered_message") @db.Text // Mensagem final renderizada
  createdAt    DateTime        @default(now()) @map("created_at")

  // Relacionamentos
  campaign MessageCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@map("campaign_recipients")
}
